{
  "name": "decoder-web",
  "version": "0.1.0",
  "description": "Decode Lightning payment strings: BOLT 11 invoices, BOLT 12 offers, invoice requests, invoices and payer proofs, LNURL and lightning addresses.",
  "keywords": [
    "ZEUS",
    "Bitcoin",
    "Lightning",
    "BOLT11",
    "BOLT12",
    "LNURL",
    "decoder"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Atlas 21 Inc.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint-fix": "eslint src/ --fix",
    "prettier": "prettier --check \"src/**/*.ts*\"",
    "prettier-write": "prettier --check --write \"src/**/*.ts*\"",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "yarn run prettier && yarn run lint && yarn run tsc"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-react": "6.1.1",
    "bolt12-utils": "0.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "light-bolt11-decoder": "3.2.0",
    "prettier": "3.9.9",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
